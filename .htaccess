<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep certificate validation reachable from the domain root.
    RewriteRule ^\.well-known/ - [L]

    # Serve Laravel's public directory without exposing /public in URLs.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(\.env|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$">
    Require all denied
</FilesMatch>
 